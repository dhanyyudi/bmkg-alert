# ══════════════════════════════════════════════════════════════════════════════
# BMKG Alert — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/bmkg_alert.db

# ── Admin Password ───────────────────────────────────────────────────────────
# Once this is changed from "changeme", every settings change needs this password.
# While it is still "changeme", anyone who can reach the instance can change settings,
# and admin login is disabled.
ADMIN_PASSWORD=changeme

# ── Demo Mode ────────────────────────────────────────────────────────────────
# When true: write operations blocked for non-admin users, trial mode enabled.
DEMO_MODE=false

# ── BMKG Data Source ─────────────────────────────────────────────────────────
BMKG_API_URL=https://bmkg-api.dhanypedia.com

# ── Reverse Proxy ────────────────────────────────────────────────────────────
# Header your proxy sets to the visitor's address, used for rate limits.
# Cloudflare: CF-Connecting-IP    nginx: X-Real-IP    no proxy: leave empty
CLIENT_IP_HEADER=

# Browser origins allowed to call the API directly (comma-separated).
# The bundled frontend needs none.
CORS_ORIGINS=

# ── Telegram (required for notifications) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord (optional) ──────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Slack (optional) ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Email / SMTP (optional) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; empty sends as SMTP_USER
SMTP_FROM=

# ── Generic Webhook (optional) ──────────────────────────────────────────────
GENERIC_WEBHOOK_URL=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Jakarta
